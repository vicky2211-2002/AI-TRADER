!app/build/
!app/build/*

# Mobile build
mobile/node_modules/
mobile/android/app/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/ios/App/Pods/
mobile/ios/App/build/

# Artifacts
*.apk
*.aab
*.dmg
*.exe
*.msi
*.AppImage
*.deb
*.snap
*.zip

# Secrets (never commit)
*.key
*.pem
.env
.env.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test artifacts
coverage/
.nyc_output/

# Frozen core payload (built by core/build_sidecar.py)
app/core-runtime/*
!app/core-runtime/README.md

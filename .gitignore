# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# AI-TRADER data
data/
*.db
*.db-journal
*.log

# Electron build
app/release/
app/release-*/
app/dist/
app/dist-electron/
app/node_modules/

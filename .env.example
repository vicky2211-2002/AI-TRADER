# AI-TRADER core environment.
# The core does not auto-load .env; export these in your shell or service wrapper.

# Where data, SQLite and the vault live. Default: %APPDATA%\AI-TRADER
AI_TRADER_HOME=

# Skills folder. Default: <repo>/skills
AI_TRADER_SKILLS=

# Bind address. 127.0.0.1 = this machine only. 0.0.0.0 = LAN (requires token).
AI_TRADER_HOST=127.0.0.1
AI_TRADER_PORT=8765

# Shared secret. When set, every /api request must send:
#   X-AI-Trader-Token: <value>
# Generate with: py -3.12 -c "import secrets; print(secrets.token_urlsafe(48))"
AI_TRADER_TOKEN=

# Desktop shell only: force a specific Python interpreter.
# AI_TRADER_PYTHON=C:\Python312\python.exe

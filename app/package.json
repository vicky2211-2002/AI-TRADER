{
  "name": "ai-trader",
  "productName": "AI-TRADER",
  "version": "0.1.2",
  "private": true,
  "description": "AI-TRADER - a Claude-style trading cockpit with custom models, MCP tools and broker execution.",
  "author": {
    "name": "AI-TRADER",
    "email": "maintainer@ai-trader.app"
  },
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:web": "vite build",
    "build": "npm run build:electron && vite build",
    "preview": "vite preview",
    "electron": "npm run build:electron && electron .",
    "dev:desktop": "concurrently -k \"vite\" \"wait-on tcp:5173 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "mobile:sync": "npm run build:web && cd ../mobile && npx cap sync",
    "mobile:android": "npm run build:web && cd ../mobile && npx cap open android",
    "mobile:apk": "npm run build:web && cd ../mobile && npx cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.aitrader.app",
    "productName": "AI-TRADER",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "core-runtime",
        "to": "core-runtime",
        "filter": ["**/*"]
      },
      {
        "from": "../core",
        "to": "core",
        "filter": ["**/*.py", "**/*.json", "!**/__pycache__/**", "!**/tests/**"]
      },
      {
        "from": "../skills",
        "to": "skills",
        "filter": ["**/*.md"]
      },
      {
        "from": "dist",
        "to": "ui"
      }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico",
      "artifactName": "AI-TRADER-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "AI-TRADER-${version}-${arch}-portable.${ext}"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "build/icon.png",
      "category": "public.app-category.finance",
      "artifactName": "AI-TRADER-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "Finance"
    }
  }
}
